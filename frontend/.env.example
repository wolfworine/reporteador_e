# Copiar a `.env` (o `.env.local`) y ajustar por entorno. NUNCA commitear
# este archivo con un valor de producción real — ver docs/conventions.md.

# URL base de la API REST del backend (Quarkus, entel-role-repository-backend).
# Si no se define, src/api/client.ts usa http://localhost:8080 como fallback
# de desarrollo local únicamente.
VITE_API_BASE_URL=http://localhost:8080
